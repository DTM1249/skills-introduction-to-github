# ─── Gmail Credentials ──────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get one: https://myaccount.google.com/apppasswords
# Steps: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASS=xxxx-xxxx-xxxx-xxxx

# ─── Recipient ───────────────────────────────────────────────────────────────
# Email address to receive the digest (defaults to GMAIL_USER if not set)
RECIPIENT_EMAIL=your-email@gmail.com

# ─── Schedule ────────────────────────────────────────────────────────────────
# Cron expression for when to send the digest (default: 7:00 AM every day)
# Format: minute hour day-of-month month day-of-week
# Examples:
#   0 7 * * *    → 7:00 AM every day
#   0 6 * * 1-5  → 6:00 AM weekdays only
#   30 8 * * *   → 8:30 AM every day
DIGEST_TIME=0 7 * * *
